{
  "expo": {
    "name": "AgentsDock",
    "slug": "agentsdock-react",
    "version": "0.1.1",
    "scheme": "com.zhengyiluo.ZenithDock",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zhengyiluo.ZenithDock",
      "buildNumber": "171",
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyCollectedDataTypes": []
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "AgentsDock connects to your private agent server on your LAN or Tailscale network.",
        "UIRequiresFullScreen": false
      }
    },
    "android": {
      "package": "com.zhengyiluo.agentsdock",
      "versionCode": 10,
      "usesCleartextTraffic": true,
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "locales": {
      "zh-CN": "./languages/zh-CN.json"
    },
    "plugins": [
      [
        "expo-localization",
        {
          "supportedLocales": ["en", "zh-CN"]
        }
      ],
      "./plugins/withIosNoAnalyticsPrivacy.cjs",
      "./plugins/withAndroidCleartextTraffic.cjs",
      "./plugins/withAndroidAsyncStorageCapacity.cjs",
      "./plugins/withAndroidReleaseSigning.cjs",
      "./plugins/withAndroidSideloadUpdater.cjs",
      "expo-secure-store",
      "expo-sharing",
      "expo-video",
      "expo-image",
      "./plugins/withAndroidMediaSave.cjs",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow AgentsDock to access photos and videos you choose to attach to agent messages.",
          "savePhotosPermission": "Allow AgentsDock to save images and videos you choose to your photo library.",
          "granularPermissions": [],
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow AgentsDock to scan a server connection QR code.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AgentsDock to access photos and videos you choose to attach to agent messages.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#2563EB",
          "defaultChannel": "default"
        }
      ],
      "expo-document-picker"
    ]
  }
}
