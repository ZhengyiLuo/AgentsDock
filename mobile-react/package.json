  "scripts": {
    "embed:editor": "node scripts/embed-code-editor.mjs",
    "embed:xterm": "node scripts/embed-xterm.mjs",
    "postinstall": "node scripts/embed-xterm.mjs && node scripts/embed-code-editor.mjs",
    "verify:ios-native": "node scripts/verify-ios-native-dependencies.mjs",
    "verify:ios-archive-abi": "node scripts/verify-ios-framework-abi.mjs",
    "verify:android-native": "node scripts/verify-android-native.mjs",
    "manifest:android-update": "node scripts/create-android-update-manifest.mjs",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:phone": "expo run:ios --device 'iPhone 17 Pro'",
    "ios:pad": "expo run:ios --device 'iPad Pro 13-inch (M5)'",
    "test:history": "node scripts/run-history-tests.mjs",
    "test:analytics": "node scripts/run-history-tests.mjs src/lib/analytics-payload.test.ts --native-mocks && node scripts/run-history-tests.mjs src/lib/analytics-ios.test.ts --native-mocks",
    "test:upload": "node scripts/run-history-tests.mjs src/api/upload.test.ts --native-mocks",
    "test:downloads": "node scripts/run-file-transfer-tests.mjs",
    "test:terminal": "node --test tests/terminal-layout.test.mjs",
    "test:server-setup": "node scripts/run-history-tests.mjs src/lib/server-setup.test.ts",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "ios": {
        "buildFromSource": [
          "expo-video"
        ]
      }
    }
  }
